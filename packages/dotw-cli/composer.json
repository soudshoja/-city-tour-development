{
    "name": "dotw/cli",
    "description": "Standalone DOTW hotel booking CLI for Akeed AI agent",
    "type": "project",
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dotw\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dotw\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/dotw"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
