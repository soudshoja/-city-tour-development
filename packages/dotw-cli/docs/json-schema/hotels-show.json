{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dotw-cli/hotels-show",
  "title": "dotw:hotels:show Response",
  "description": "Success response from dotw:hotels:show --json. Returns hotel details and available rooms.",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": { "type": "string", "enum": ["success"] },
    "data": {
      "type": "object",
      "required": ["hotel_id", "rooms"],
      "properties": {
        "hotel_id":    { "type": "string" },
        "hotel_name":  { "type": "string" },
        "star_rating": { "type": "string" },
        "rooms": {
          "type": "array",
          "description": "Available room types with rate options. Use index N with dotw:prebook <hotel_id> <N>.",
          "items": {
            "type": "object",
            "required": ["index", "room_type_code", "room_name", "rate_basis_id", "total_fare", "currency"],
            "properties": {
              "index":               { "type": "integer", "description": "Zero-based index. Pass as second argument to dotw:prebook." },
              "room_type_code":      { "type": "string" },
              "room_name":          { "type": "string" },
              "rate_basis_id":      { "type": "integer" },
              "rate_basis_name":    { "type": "string" },
              "total_fare":         { "type": "number" },
              "currency":           { "type": "string" },
              "allocation_details": { "type": "string" },
              "cancellation_policy":{ "type": "string" }
            }
          }
        }
      }
    }
  }
}
