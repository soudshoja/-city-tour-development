{
    "name": "dotw/xml-cli",
    "description": "Low-level DOTW XML pass-through CLI — one command per API method",
    "type": "project",
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dotw\\XmlCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dotw\\XmlCli\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/dotw-xml"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
