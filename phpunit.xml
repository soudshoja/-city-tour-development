<?xml version="1.0" encoding="UTF-8"?>
<!--
    PARALLEL AGENTS / ISOLATED TEST DATABASES

    Databases must exist before running tests -create them with:
        php scripts/dev/create-test-db.php city_tour_test_<name>
    (refuses any name not starting with "city_tour_test").

    Usage (Git Bash / POSIX):
        DB_TEST_DATABASE=city_tour_test_agent7 DB_DATABASE_MAP=city_tour_test_agent7_map \
            php artisan test tests/Feature/Accounting tests/Unit/Services/Accounting

    Usage (PowerShell):
        $env:DB_TEST_DATABASE='city_tour_test_agent7'; $env:DB_DATABASE_MAP='city_tour_test_agent7_map'; `
            php artisan test tests/Feature/Accounting tests/Unit/Services/Accounting

    WHAT force= DOES AND DOES NOT DO ON THE TWO <env> ENTRIES BELOW (verified
    against vendor/phpunit/phpunit/src/TextUI/Configuration/PhpHandler.php and
    Laravel's Illuminate\Config\Repository / vlucas/phpdotenv Env handling):
    PHPUnit's PhpHandler writes env values via putenv()/$_ENV only -it never
    touches $_SERVER. Laravel's env() helper (via Repository::get) reads
    $_SERVER first, before $_ENV/getenv(). A value you export in the shell
    (`DB_TEST_DATABASE=... php artisan test`, or PowerShell `$env:...=...;`)
    lands in $_SERVER and therefore ALWAYS wins over whatever is declared
    here, REGARDLESS of force="true" or force="false" on these two lines.
    force is not what makes per-agent isolation work, and it is not what
    would let a stale default "guarantee" a value either -both framings seen
    in earlier revisions of this comment were wrong. Whichever force value is
    currently set below is not load-bearing; do not change behavior by
    flipping it.

    The ONLY thing standing between a misconfigured/missing shell export and
    RefreshDatabase running migrate:fresh against laravel_testing or
    map_data_citytour is the hard safety rail in tests/TestCase.php
    (guardTestDatabaseIsolation(), shared with tests/DuskTestCase.php via
    Tests\Concerns\GuardsTestDatabaseIsolation) -it throws a RuntimeException
    from setUp(), before any migration executes, unless the RESOLVED
    connection config for mysql_testing, mysql_map, AND accounting_audit all
    start with "city_tour_test". This throw happens PER TEST (setUp() runs
    once per test method), not once for the whole run -a misconfigured run
    reports one "FATAL TEST-SAFETY ABORT" failure per test that would have
    touched the database, not a single abort -see that trait for details.

    PRE-GRANTED DATABASE NAMES: laravel_user has no global CREATE DATABASE
    privilege, so scripts/dev/create-test-db.php can only succeed for a name
    already granted to it individually. An admin can remove this recurring
    friction with one one-time pattern grant (note the escaped underscores -
    MySQL treats a bare "_" as a single-character wildcard in GRANT ... ON
    names, so it must be escaped to mean a literal underscore):
        GRANT ALL PRIVILEGES ON `city\_tour\_test%`.* TO 'laravel_user'@'localhost';
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql_testing" force="true"/>
        <env name="DB_DATABASE" value="city_tour_test" force="true"/>
        <!--
            SAFETY (see .planning/P1-VERIFICATION-FINDINGS.json): the mysql_testing
            connection in config/database.php reads its database name from
            DB_TEST_DATABASE, NOT DB_DATABASE. .env sets DB_TEST_DATABASE to
            laravel_testing (the PRIMARY local application database). These two
            defaults exist so a bare `php artisan test`, with nothing exported
            in the shell, still lands on a disposable database instead of
            laravel_testing / map_data_citytour. See the top-of-file comment:
            force= here does NOT decide who wins against a shell export
            either way -a shell-exported DB_TEST_DATABASE/DB_DATABASE_MAP
            always wins over these regardless of force, because it lands in
            $_SERVER and PHPUnit's PhpHandler never writes $_SERVER. The real
            backstop is tests/TestCase.php's guardTestDatabaseIsolation().
        -->
        <env name="DB_TEST_DATABASE" value="city_tour_test" force="false"/>
        <env name="DB_DATABASE_MAP" value="city_tour_test_map" force="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!--
            Pre-existing gap (both merge parents, not merge-introduced): the real .env
            leaves N8N_WEBHOOK_URL empty, and ManualInterventionController::queueToN8n()
            throws before ever calling Http::post() when it's unset — so
            ManualInterventionEnhancedTest's Http::fake() never got a chance to intercept
            anything. A harmless fake URL here lets that fake actually take effect.
        -->
        <env name="N8N_WEBHOOK_URL" value="http://localhost/fake-n8n-webhook-for-tests"/>
    </php>
</phpunit>
